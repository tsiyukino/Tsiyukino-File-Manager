<UserControl x:Class="TSFM.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TSFM.Converters"
             Background="#F5F5F5">
    <UserControl.Resources>
        <converters:DepthToMarginConverter x:Key="DepthToMarginConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Categories Panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="0" Margin="0,0,8,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Manager}" 
                                  Fill="#4285F4" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Categories"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#202124"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="40" 
                                        Padding="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                        Background="Transparent" 
                                        CornerRadius="8"
                                        Margin="0,0,0,2"
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="Category_Click" 
                                        Tag="{Binding Id}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F3F4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                        <Path Data="{StaticResource Icon.Folder}" 
                                              Fill="#5F6368" 
                                              Width="14" 
                                              Height="14"
                                              Stretch="Uniform"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   Foreground="#3C4043"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="36" Margin="0,0,6,0"
                                Style="{StaticResource CustomButton}" Click="AddCategory_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Add}" 
                                      Fill="#5F6368" 
                                      Width="14" 
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Add" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Height="36" Margin="6,0,0,0"
                                Style="{StaticResource CustomButton}" Click="DeleteCategory_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Delete}" 
                                      Fill="#C5221F" 
                                      Width="14" 
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Delete" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Files Panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="0" Margin="0,0,8,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Folder}" 
                                  Fill="#4285F4" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Files"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#202124"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} items'}"
                                   FontSize="12"
                                   Foreground="#5F6368"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#F8F9FA" Padding="20,8">
                    <Border Background="White" 
                            BorderBrush="#DADCE0" 
                            BorderThickness="1" 
                            CornerRadius="20"
                            Height="40">
                        <Grid>
                            <Path Data="{StaticResource Icon.Search}" 
                                  Fill="#5F6368" 
                                  Width="16" 
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" 
                                  Margin="16,0,0,0"
                                  HorizontalAlignment="Left"/>
                            <TextBox x:Name="SearchBox"
                                     Height="40" 
                                     Padding="40,0,16,0" 
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#202124"
                                     FontSize="14">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E8EAED"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,0,12"
                                        Height="76"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="File_Click"
                                        Tag="{Binding Id}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4285F4"/>
                                                    <Setter Property="Background" Value="#F8F9FA"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" 
                                                Width="44" 
                                                Height="44" 
                                                Background="#E8F0FE" 
                                                CornerRadius="10"
                                                Margin="0,0,12,0">
                                            <Path Data="{StaticResource Icon.Folder}" 
                                                  Fill="#4285F4" 
                                                  Width="20" 
                                                  Height="20"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="Medium"
                                                       Foreground="#202124"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Modified recently"
                                                       FontSize="12"
                                                       Foreground="#5F6368"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                CornerRadius="16"
                                                Padding="14,6"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E6F4EA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Background" Value="#FCE8E6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Enable}"/>
                                                            <Setter Property="Fill" Value="#137333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Disable}"/>
                                                                    <Setter Property="Fill" Value="#C5221F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock FontSize="13" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Enabled"/>
                                                            <Setter Property="Foreground" Value="#137333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Text" Value="Disabled"/>
                                                                    <Setter Property="Foreground" Value="#C5221F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="36" Margin="0,0,6,0"
                                Style="{StaticResource CustomButton}" Click="AddFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Add}" 
                                      Fill="#5F6368" 
                                      Width="14" 
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Add" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Height="36" Margin="3,0"
                                Style="{StaticResource CustomButton}" Click="ToggleFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Enable}" 
                                      Fill="#5F6368" 
                                      Width="14" 
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Toggle" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Height="36" Margin="6,0,0,0"
                                Style="{StaticResource CustomButton}" Click="DeleteFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Delete}" 
                                      Fill="#C5221F" 
                                      Width="14" 
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Delete" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Details Panel -->
        <Border Grid.Column="2" Background="White" CornerRadius="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Find}" 
                              Fill="#4285F4" 
                              Width="20" 
                              Height="20"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#202124"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,24">
                        <Border Background="#F8F9FA" 
                                CornerRadius="12" 
                                Padding="24"
                                BorderBrush="#E8EAED"
                                BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="48" Height="48" Margin="0,0,0,12">
                                    <Path Data="{StaticResource Icon.Find}" 
                                          Fill="#DADCE0"
                                          Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Text="No file selected"
                                           FontSize="16"
                                           FontWeight="Medium"
                                           Foreground="#5F6368"
                                           TextAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Select a file to view details"
                                           FontSize="13"
                                           Foreground="#80868B"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

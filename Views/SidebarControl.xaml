<UserControl x:Class="TSFM.Views.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             Background="White">
    <Border BorderBrush="#E8EAED" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Toggle -->
            <Border Grid.Row="0" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" Padding="16">
                <Grid VerticalAlignment="Center">
                    <!-- When Collapsed: Show Menu Icon -->
                    <Button x:Name="ExpandButton"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Click="ToggleButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <Path Data="{StaticResource Icon.Menu}" 
                                          Fill="#5F6368" 
                                          Width="20" 
                                          Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- When Expanded: Show Title and Close Icon -->
                    <Grid x:Name="ExpandedHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="File Manager" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="#202124"/>
                            <TextBlock Text="Manage your mods"
                                       FontSize="11"
                                       Foreground="#5F6368"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ToggleButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <Path Data="{StaticResource Icon.Close}" 
                                              Fill="#5F6368" 
                                              Width="20" 
                                              Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F3F4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Navigation -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NavPanel" Margin="8,12,8,12">
                    <!-- Main Section Label -->
                    <TextBlock x:Name="MainLabel"
                               Text="MAIN" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#5F6368"
                               Margin="8,0,0,8"/>

                    <!-- Home Button -->
                    <Border x:Name="HomeButton" 
                            Margin="0,0,0,4"
                            Background="Transparent"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseEnter="NavButton_MouseEnter"
                            MouseLeave="NavButton_MouseLeave"
                            MouseLeftButtonDown="HomeButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Collapsed: Center Icon -->
                            <Path x:Name="HomeIconCollapsed"
                                  Data="{StaticResource Icon.Home}" 
                                  Fill="#5F6368" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            
                            <!-- Expanded: Icon + Text -->
                            <Grid x:Name="HomeExpanded" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Home}" 
                                      Fill="#5F6368" 
                                      Width="20" 
                                      Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="1"
                                           Text="Home" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           Foreground="#202124"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Games Button -->
                    <Border x:Name="GamesButton" 
                            Margin="0,0,0,4"
                            Background="Transparent"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseEnter="NavButton_MouseEnter"
                            MouseLeave="NavButton_MouseLeave"
                            MouseLeftButtonDown="GamesButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Path x:Name="GamesIconCollapsed"
                                  Data="{StaticResource Icon.Games}" 
                                  Fill="#5F6368" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            
                            <Grid x:Name="GamesExpanded" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Games}" 
                                      Fill="#5F6368" 
                                      Width="20" 
                                      Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="1"
                                           Text="Games" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           Foreground="#202124"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Project Section Label -->
                    <TextBlock x:Name="ProjectLabel"
                               Text="PROJECT" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#5F6368"
                               Margin="8,16,0,8"/>

                    <!-- Manager Button -->
                    <Border x:Name="ManagerButton" 
                            Margin="0,0,0,4"
                            Background="Transparent"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseEnter="NavButton_MouseEnter"
                            MouseLeave="NavButton_MouseLeave"
                            MouseLeftButtonDown="ManagerButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CurrentProjectId}" Value="-1">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Path x:Name="ManagerIconCollapsed"
                                  Data="{StaticResource Icon.Manager}" 
                                  Fill="#5F6368" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            
                            <Grid x:Name="ManagerExpanded" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Manager}" 
                                      Fill="#5F6368" 
                                      Width="20" 
                                      Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="1"
                                           Text="File Manager" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           Foreground="#202124"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Tags Button -->
                    <Border x:Name="TagsButton" 
                            Margin="0,0,0,4"
                            Background="Transparent"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseEnter="NavButton_MouseEnter"
                            MouseLeave="NavButton_MouseLeave"
                            MouseLeftButtonDown="TagsButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CurrentProjectId}" Value="-1">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Path x:Name="TagsIconCollapsed"
                                  Data="{StaticResource Icon.Tags}" 
                                  Fill="#5F6368" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            
                            <Grid x:Name="TagsExpanded" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Tags}" 
                                      Fill="#5F6368" 
                                      Width="20" 
                                      Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="1"
                                           Text="Tags" 
                                           FontSize="14" 
                                           FontWeight="Medium"
                                           Foreground="#202124"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings Footer -->
            <Border Grid.Row="2" BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Padding="8,12">
                <Border x:Name="SettingsButton" 
                        Background="Transparent"
                        CornerRadius="10"
                        Cursor="Hand"
                        MouseEnter="NavButton_MouseEnter"
                        MouseLeave="NavButton_MouseLeave"
                        MouseLeftButtonDown="SettingsButton_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="48"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F3F4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Path x:Name="SettingsIconCollapsed"
                              Data="{StaticResource Icon.Settings}" 
                              Fill="#5F6368" 
                              Width="20" 
                              Height="20"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        
                        <Grid x:Name="SettingsExpanded" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Path Grid.Column="0"
                                  Data="{StaticResource Icon.Settings}" 
                                  Fill="#5F6368" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="1"
                                       Text="Settings" 
                                       FontSize="14" 
                                       FontWeight="Medium"
                                       Foreground="#202124"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>

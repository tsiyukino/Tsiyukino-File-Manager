<UserControl x:Class="TSFM.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,60,40,40">
        <StackPanel HorizontalAlignment="Center" MaxWidth="1200">
            <!-- Hero Section -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,60">
                <TextBlock Text="Welcome to File Manager"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#4285f4"
                           TextAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Organize and manage your files with ease"
                           FontSize="20"
                           Foreground="#5F6368"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Features -->
            <Grid MaxWidth="1000" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0"
                        Background="White" 
                        CornerRadius="16" 
                        Padding="40,32"
                        BorderBrush="#E8EAED"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <Viewbox Width="64" Height="64" Margin="0,0,0,16">
                            <Path Data="{StaticResource Icon.Games}" 
                                  Fill="#202124"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Multi-Game Support"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="#202124"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Manage files for multiple games in one place"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#5F6368"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White" 
                        CornerRadius="16" 
                        Padding="40,32"
                        BorderBrush="#E8EAED"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <Viewbox Width="64" Height="64" Margin="0,0,0,16">
                            <Path Data="{StaticResource Icon.Folder}" 
                                  Fill="#202124"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Easy Organization"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="#202124"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Categories, tags, and notes to keep everything organized"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#5F6368"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="White" 
                        CornerRadius="16" 
                        Padding="40,32"
                        BorderBrush="#E8EAED"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <Viewbox Width="64" Height="64" Margin="0,0,0,16">
                            <Path Data="{StaticResource Icon.Enable}" 
                                  Fill="#202124"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Quick Toggle"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="#202124"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Enable or disable files with a single click"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#5F6368"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action Hint -->
            <Border Background="#E8F0FE"
                    BorderBrush="#4285F4"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,16"
                    MaxWidth="1000">
                <TextBlock Text="Select a game from the sidebar to get started"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="#1967D2"
                           TextAlignment="Center"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

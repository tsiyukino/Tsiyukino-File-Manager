<Window x:Class="TSFM.Views.GameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Dialog" 
        Height="650" Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="White" CornerRadius="16" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="73"/>
                <RowDefinition/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" Padding="32,0" Background="White" CornerRadius="16,16,0,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Games}" 
                              Fill="#4285F4" 
                              Width="28" 
                              Height="28"
                              Stretch="Uniform"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#202124"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Click="CancelButton_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <Path Data="{StaticResource Icon.Close}" 
                                          Fill="#5F6368" 
                                          Width="20" 
                                          Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="40,32,40,24" Margin="40,30,40,30">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#DADCE0" CornerRadius="4" Width="6" Margin="1,0"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel>
                    <!-- Name Field -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="Game Name *" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Foreground="#5F6368"
                                   Margin="0,0,0,10"/>
                        <Border BorderBrush="#DADCE0" 
                                BorderThickness="1" 
                                CornerRadius="8"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="#4285F4"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox x:Name="NameTextBox" 
                                     Height="36"
                                     Padding="16,0"
                                     FontSize="15"
                                     Foreground="#202124"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="0"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <!-- Image Path Field -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="Cover Image (Optional)" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Foreground="#5F6368"
                                   Margin="0,0,0,10"/>
                        <Grid Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="#DADCE0" 
                                    BorderThickness="1" 
                                    CornerRadius="8"
                                    Background="White">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="#4285F4"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox x:Name="ImagePathTextBox"
                                         Padding="16,0"
                                         FontSize="14"
                                         Foreground="#202124"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent" Margin="0,0,0,-1">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                                      VerticalAlignment="Center"
                                                                      Margin="0"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>

                            <Button Grid.Column="2"
                                    Height="52"
                                    Width="120"
                                    Style="{StaticResource CustomButton}"
                                    Click="BrowseButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" 
                                          Fill="#5F6368" 
                                          Width="16" 
                                          Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"/>
                                    <TextBlock Text="Browse" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Description Field -->
                    <StackPanel>
                        <TextBlock Text="Description (Optional)" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Foreground="#5F6368"
                                   Margin="0,0,0,10"/>
                        <Border BorderBrush="#DADCE0" 
                                BorderThickness="1" 
                                CornerRadius="8"
                                Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="#4285F4"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox x:Name="DescriptionTextBox"
                                     Height="150"
                                     Padding="16,14"
                                     FontSize="14"
                                     Foreground="#202124"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <TextBox.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid>
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="#DADCE0" CornerRadius="4" Width="6" Margin="1,0"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Padding="32,0" Background="White" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Height="48"
                            Width="120"
                            Style="{StaticResource CustomButton}"
                            Margin="0,0,12,0"
                            Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Close}" 
                                  Fill="#5F6368" 
                                  Width="16" 
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Cancel" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Height="48"
                            Width="120"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Enable}" 
                                  Fill="White" 
                                  Width="16" 
                                  Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Save" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="TSFM.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TSFM.Views"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="White" Padding="32,0" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Games}" 
                              Fill="#4285F4" 
                              Width="32" 
                              Height="32"
                              Stretch="Uniform"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Your Games"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#202124"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Projects.Count, StringFormat='Manage {0} game projects'}"
                               FontSize="14"
                               Foreground="#5F6368"
                               Margin="44,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Height="40"
                        Padding="24,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddGame_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Add}" 
                              Fill="White" 
                              Width="18" 
                              Height="18"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Add Game" 
                                   FontSize="15" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Games Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:GameCard Width="300" 
                                       Height="380" 
                                       Margin="8"
                                       GameName="{Binding Name}"
                                       GameId="{Binding Id}"
                                       ImagePath="{Binding ImagePath}"
                                       GameCardClick="GameCard_Click"
                                       EditClick="EditGame_Click"
                                       DeleteClick="DeleteGame_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
